---
// src/layouts/ToolLayout.astro
import BaseLayout from './BaseLayout.astro';
import AdSlot from '@/components/ads/AdSlot.astro';
import { ADS_CONFIG } from '@/lib/ads-config';

interface Props {
  title: string;
  description: string;
  category: string;
  canonicalPath?: string;
  faqs?: Array<{ question: string; answer: string }>;
}

const { title, description, category, canonicalPath, faqs = [] } = Astro.props;

const breadcrumbs = [
  { name: category.charAt(0).toUpperCase() + category.slice(1), path: '/' },
  { name: title, path: canonicalPath || '' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  isTool={true}
  faqs={faqs}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-7 md:py-8">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 font-mono text-[11px] text-neutral-500 mb-4" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-neutral-950 dark:hover:text-neutral-100 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-neutral-900 dark:focus-visible:ring-white rounded">
        Catálogo
      </a>
      <span class="text-neutral-300 dark:text-neutral-700" aria-hidden="true">/</span>
      <span class="capitalize text-neutral-500 dark:text-neutral-400">{category}</span>
      <span class="text-neutral-300 dark:text-neutral-700" aria-hidden="true">/</span>
      <span class="text-neutral-900 dark:text-white font-medium" aria-current="page">{title}</span>
    </nav>

    <!-- Unified Tool Header Editorial -->
    <header class="border-b border-neutral-200 dark:border-neutral-800 pb-4 mb-4 sm:pb-5 sm:mb-6">
      <div class="flex flex-wrap items-center gap-2 font-mono text-[11px] mb-2.5">
        <span class="px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-50 dark:bg-neutral-900 font-semibold text-[10px]">
          {category}
        </span>
        <span class="px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 font-medium text-[10px]">
          100% Client-Side
        </span>
        <span class="px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 font-medium text-[10px]">
          Zero Data Egress
        </span>
      </div>

      <h1 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-neutral-950 dark:text-white mb-2">
        {title}
      </h1>

      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 max-w-3xl leading-relaxed">
        {description}
      </p>

      <!-- Barra de Salto Rápido para Minimizar Scroll -->
      <nav class="flex items-center gap-2 pt-3 mt-3 border-t border-neutral-100 dark:border-neutral-800/60 font-mono text-[11px]" aria-label="Navegación de secciones">
        <span class="text-neutral-400 dark:text-neutral-600">Saltar a:</span>
        <a
          href="#tool-workspace"
          class="px-2 py-0.5 rounded text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white bg-neutral-100/70 dark:bg-neutral-900 hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors"
        >
          Generador
        </a>
        <a
          href="#technical-guide"
          class="px-2 py-0.5 rounded text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white bg-neutral-100/70 dark:bg-neutral-900 hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors"
        >
          Especificaciones ISO
        </a>
        {faqs.length > 0 && (
          <a
            href="#technical-faqs"
            class="px-2 py-0.5 rounded text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white bg-neutral-100/70 dark:bg-neutral-900 hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors"
          >
            FAQs ({faqs.length})
          </a>
        )}
      </nav>
    </header>

    <!-- Espacio de la Herramienta Interactiva -->
    <section id="tool-workspace" class="mb-6 sm:mb-8" aria-label={`Área de ejecución de ${title}`}>
      <slot name="tool-workspace" />
    </section>

    <!-- Slot Publicitario 1 (Inmediatamente después de la herramienta, Cero CLS) -->
    <AdSlot
      slotId={ADS_CONFIG.slots.toolTop}
      slotName="Herramienta Superior"
      format="horizontal-responsive"
      className="my-6"
    />

    <!-- Guía Técnica Editorial y Contenido de Valor (Colapsable/Accesible para Reducir Scroll) -->
    <section id="technical-guide" class="my-6 sm:my-8 border border-neutral-200 dark:border-neutral-800 rounded-lg bg-neutral-50/50 dark:bg-neutral-900/30 overflow-hidden" aria-label="Especificaciones Técnicas y Documentación">
      <details id="technical-guide-details" class="group [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex items-center justify-between p-4 sm:p-5 cursor-pointer select-none bg-white dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800 group-hover:bg-neutral-50 dark:group-hover:bg-neutral-800/50 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-900 dark:focus-visible:ring-white">
          <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full bg-neutral-900 dark:bg-white" aria-hidden="true"></span>
            <div>
              <h2 class="text-xs sm:text-sm font-bold text-neutral-950 dark:text-white font-mono uppercase tracking-wider">
                Documentación Técnica & Estándar ISO/IEC 18004
              </h2>
              <p class="text-[11px] text-neutral-500 mt-0.5">
                Fundamentos matemáticos Reed-Solomon, anatomía óptica y reglas de impresión 10:1
              </p>
            </div>
          </div>
          <span class="font-mono text-xs text-neutral-400 group-open:rotate-180 transition-transform duration-200 px-2 py-1 rounded bg-neutral-100 dark:bg-neutral-800" aria-hidden="true">
            ▼
          </span>
        </summary>

        <div class="p-4 sm:p-6 bg-white dark:bg-neutral-950">
          <article class="prose prose-neutral dark:prose-invert max-w-none text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed [&_h2]:text-sm sm:[&_h2]:text-base [&_h2]:font-bold [&_h2]:text-neutral-950 [&_h2]:dark:text-white [&_h2]:mt-6 [&_h2]:mb-2 [&_h3]:text-xs sm:[&_h3]:text-sm [&_h3]:font-semibold [&_h3]:mt-4 [&_h3]:mb-1.5 [&_p]:mb-3 [&_ul]:mb-3 [&_ul]:pl-5 [&_li]:mb-1 [&_pre]:p-3 [&_pre]:text-[11px] [&_table]:text-[11px] [&_table]:font-mono">
            <slot name="editorial-content" />
          </article>
        </div>
      </details>
      <script is:inline>
        if (window.innerWidth >= 768) {
          const d = document.getElementById('technical-guide-details');
          if (d) d.setAttribute('open', '');
        }
      </script>
    </section>

    <!-- Sección de Preguntas Frecuentes (FAQ) -->
    {faqs.length > 0 && (
      <section id="technical-faqs" class="mt-8 border-t border-neutral-200 dark:border-neutral-800 pt-6" aria-label="Preguntas Frecuentes Técnicas">
        <div class="mb-4">
          <span class="font-mono text-[11px] uppercase tracking-wider text-neutral-500">Soporte y Respuestas Técnicas</span>
          <h2 class="text-base sm:text-lg font-bold text-neutral-950 dark:text-white mt-0.5">
            Preguntas Frecuentes
          </h2>
        </div>

        <div class="divide-y divide-neutral-200 dark:divide-neutral-800 border-y border-neutral-200 dark:border-neutral-800">
          {faqs.map((faq) => (
            <details class="group py-3 transition-colors [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between font-semibold text-neutral-900 dark:text-white cursor-pointer select-none text-xs sm:text-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-neutral-900 dark:focus-visible:ring-white rounded">
                <span>{faq.question}</span>
                <span class="ml-4 font-mono text-xs text-neutral-400 group-open:rotate-45 transition-transform duration-200 flex-shrink-0" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="mt-2 text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed pr-6">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Slot Publicitario 2 (Final de página, Cero CLS) -->
    <AdSlot
      slotId={ADS_CONFIG.slots.toolBottom}
      slotName="Herramienta Inferior"
      format="horizontal-responsive"
      className="my-6"
    />
  </div>
</BaseLayout>
