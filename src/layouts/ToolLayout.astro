---
// src/layouts/ToolLayout.astro
import BaseLayout from './BaseLayout.astro';
import AdSlot from '@/components/ads/AdSlot.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  canonicalPath?: string;
  faqs?: Array<{ question: string; answer: string }>;
}

const { title, description, category, canonicalPath, faqs = [] } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  isTool={true}
  faqs={faqs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Inicio</a>
      <span>/</span>
      <span class="capitalize text-slate-600 dark:text-slate-300">{category}</span>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-medium" aria-current="page">{title}</span>
    </nav>

    <!-- Tool Header -->
    <div class="mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-700 dark:text-brand-400 border border-brand-500/20">
          {category.toUpperCase()}
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 flex items-center gap-1">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          100% Client-Side (Privado)
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-700 dark:text-blue-400 border border-blue-500/20">
          Cero Cómputo en Servidor
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-3">
        {title}
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-3xl leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Espacio de la Herramienta Interactiva -->
    <section class="mb-12" aria-label="Área de trabajo de la herramienta">
      <slot name="tool-workspace" />
    </section>

    <!-- Slot Publicitario 1 (Inmediatamente después de la herramienta, Cero CLS) -->
    <AdSlot slotId="ad-tool-top" format="horizontal-responsive" className="my-10" />

    <!-- Guía Técnica Editorial y Contenido de Valor (SEO & AdSense Compliance) -->
    <article class="prose prose-slate dark:prose-invert max-w-none border-t border-slate-200 dark:border-slate-800 pt-10">
      <slot name="editorial-content" />
    </article>

    <!-- Sección de Preguntas Frecuentes (FAQ) -->
    {faqs.length > 0 && (
      <section class="mt-14 border-t border-slate-200 dark:border-slate-800 pt-10" aria-label="Preguntas Frecuentes">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">
          Preguntas Frecuentes Técnicas
        </h2>
        <div class="space-y-4 max-w-4xl">
          {faqs.map((faq) => (
            <details class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 transition-colors [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between font-semibold text-slate-900 dark:text-white cursor-pointer select-none">
                <span class="text-base">{faq.question}</span>
                <span class="ml-4 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </span>
              </summary>
              <p class="mt-4 text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-100 dark:border-slate-800/60 pt-3">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Slot Publicitario 2 (Final de página, Cero CLS) -->
    <AdSlot slotId="ad-tool-bottom" format="horizontal-responsive" className="my-12" />
  </div>
</BaseLayout>
