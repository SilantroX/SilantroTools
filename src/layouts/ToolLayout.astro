---
// src/layouts/ToolLayout.astro
import BaseLayout from './BaseLayout.astro';
import AdSlot from '@/components/ads/AdSlot.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  canonicalPath?: string;
  faqs?: Array<{ question: string; answer: string }>;
}

const { title, description, category, canonicalPath, faqs = [] } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  isTool={true}
  faqs={faqs}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 font-mono text-xs text-neutral-400 dark:text-neutral-500 mb-6" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Catálogo</a>
      <span>/</span>
      <span class="capitalize text-neutral-500 dark:text-neutral-400">{category}</span>
      <span>/</span>
      <span class="text-neutral-900 dark:text-white font-medium" aria-current="page">{title}</span>
    </nav>

    <!-- Tool Header Editorial -->
    <div class="border-b border-neutral-200 dark:border-neutral-800 pb-8 mb-8">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs mb-3">
        <span class="px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 uppercase tracking-wider text-neutral-600 dark:text-neutral-400">
          {category}
        </span>
        <span class="px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400">
          100% Client-Side
        </span>
        <span class="px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400">
          Zero Egress
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-neutral-950 dark:text-white mb-3">
        {title}
      </h1>
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 max-w-3xl leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Espacio de la Herramienta Interactiva -->
    <section class="mb-12" aria-label="Área de ejecución de la herramienta">
      <slot name="tool-workspace" />
    </section>

    <!-- Slot Publicitario 1 (Inmediatamente después de la herramienta, Cero CLS) -->
    <AdSlot slotId="ad-tool-top" format="horizontal-responsive" className="my-10" />

    <!-- Guía Técnica Editorial y Contenido de Valor (SEO & AdSense Compliance) -->
    <article class="prose prose-neutral dark:prose-invert max-w-none border-t border-neutral-200 dark:border-neutral-800 pt-10 text-neutral-700 dark:text-neutral-300">
      <slot name="editorial-content" />
    </article>

    <!-- Sección de Preguntas Frecuentes (FAQ) -->
    {faqs.length > 0 && (
      <section class="mt-14 border-t border-neutral-200 dark:border-neutral-800 pt-10" aria-label="Preguntas Frecuentes Técnicas">
        <div class="mb-6">
          <span class="font-mono text-xs uppercase tracking-wider text-neutral-500">Documentación</span>
          <h2 class="text-xl sm:text-2xl font-bold text-neutral-950 dark:text-white mt-1">
            Preguntas Frecuentes
          </h2>
        </div>

        <div class="divide-y divide-neutral-200 dark:divide-neutral-800 border-y border-neutral-200 dark:border-neutral-800">
          {faqs.map((faq) => (
            <details class="group py-4 transition-colors [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between font-semibold text-neutral-900 dark:text-white cursor-pointer select-none text-sm sm:text-base">
                <span>{faq.question}</span>
                <span class="ml-4 font-mono text-xs text-neutral-400 group-open:rotate-45 transition-transform duration-200">
                  +
                </span>
              </summary>
              <p class="mt-3 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed pr-6">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Slot Publicitario 2 (Final de página, Cero CLS) -->
    <AdSlot slotId="ad-tool-bottom" format="horizontal-responsive" className="my-12" />
  </div>
</BaseLayout>
