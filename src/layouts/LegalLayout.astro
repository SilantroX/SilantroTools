---
// src/layouts/LegalLayout.astro
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  lastUpdated?: string;
}

const { title, description, lastUpdated = 'Octubre 2026' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="mb-8 border-b border-slate-200 dark:border-slate-800 pb-6">
      <div class="flex items-center gap-2 text-xs font-semibold text-brand-600 dark:text-brand-400 uppercase tracking-widest mb-2">
        Silantro Labs Legal & Transparencia
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
        {title}
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Última actualización: {lastUpdated}
      </p>
    </div>

    <div class="prose prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 leading-relaxed">
      <slot />
    </div>
  </div>
</BaseLayout>
