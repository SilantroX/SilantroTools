---
// src/pages/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';

const availableTools = [
  {
    title: 'Generador de QR by Silantro Labs',
    slug: 'qr-generator',
    description: 'Crea códigos QR personalizados en alta resolución con logotipo de Silantro Labs o tu propia marca, colores a medida y descarga inmediata en PNG o SVG. 100% privado en tu navegador.',
    category: 'Generadores',
    isAvailable: true,
    badge: 'Disponible',
    icon: 'qr',
  },
  {
    title: 'Formateador y Validador JSON',
    slug: 'json-formatter',
    description: 'Valida, embellece y analiza árboles de estructuras JSON complejas sin enviar tus datos o tokens a ningún servidor.',
    category: 'Formateadores',
    isAvailable: false,
    badge: 'Próximamente',
    icon: 'code',
  },
  {
    title: 'Conversor Base64 & Archivos',
    slug: 'base64-converter',
    description: 'Codifica y decodifica cadenas de texto, imágenes y documentos en Base64 al instante utilizando la API binaria del navegador.',
    category: 'Conversores',
    isAvailable: false,
    badge: 'Próximamente',
    icon: 'refresh',
  },
  {
    title: 'Generador de Contraseñas Seguras',
    slug: 'password-generator',
    description: 'Genera credenciales criptográficamente seguras con la API Web Crypto nativa de tu dispositivo, sin almacenamiento remoto.',
    category: 'Seguridad',
    isAvailable: false,
    badge: 'Próximamente',
    icon: 'shield',
  },
  {
    title: 'Contador y Analizador de Texto',
    slug: 'word-counter',
    description: 'Calcula caracteres, palabras, tiempo estimado de lectura y densidad semántica en tiempo real con cero latencia.',
    category: 'Texto',
    isAvailable: false,
    badge: 'Próximamente',
    icon: 'type',
  },
];
---

<BaseLayout
  title="Micro-Herramientas Gratuitas y 100% Privadas en el Cliente"
  description="Colección de herramientas web de alta velocidad para desarrolladores y creadores. Procesamiento exclusivo en el navegador, sin backend y con privacidad total."
  canonicalPath="/"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 bg-gradient-to-b from-brand-50/40 via-transparent to-transparent dark:from-brand-950/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-700 dark:text-brand-400 border border-brand-500/20 mb-6">
        <span class="w-2 h-2 rounded-full bg-brand-500"></span>
        Zero Server Egress • 100% Cómputo Local
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight max-w-4xl mx-auto">
        Micro-herramientas potentes, <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-brand-600 to-emerald-500 bg-clip-text text-transparent">
          privadas e instantáneas.
        </span>
      </h1>
      <p class="mt-6 text-base sm:text-lg md:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Todas nuestras herramientas se ejecutan de principio a fin en la memoria de tu dispositivo. Ningún texto, archivo o imagen viaja por la red a servidores de cómputo.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/tools/qr-generator/"
          class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm shadow-sm shadow-brand-500/25 transition-all hover:scale-[1.02] flex items-center gap-2"
        >
          <span>Abrir Generador QR</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <a
          href="#catalogo"
          class="px-6 py-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-200 font-semibold text-sm hover:bg-slate-50 dark:hover:bg-slate-800/80 transition-all"
        >
          Explorar Catálogo
        </a>
      </div>
    </div>
  </section>

  <!-- Pilares de Confianza -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 border-y border-slate-200 dark:border-slate-800">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
        </div>
        <div>
          <h2 class="font-bold text-slate-900 dark:text-white text-base mb-1">Privacidad Absoluta</h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Tus datos nunca tocan un servidor externo. Todo cálculo o renderizado se realiza localmente con JavaScript en tu navegador.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <div>
          <h2 class="font-bold text-slate-900 dark:text-white text-base mb-1">Velocidad Instantánea</h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Sin latencia de red ni colas de espera en backend. Las microherramientas responden a la velocidad de la CPU de tu propio equipo.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <h2 class="font-bold text-slate-900 dark:text-white text-base mb-1">100% Gratis y Sin Registro</h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Acceso libre sin límites de uso, sin muros de pago y sin necesidad de crear cuentas de usuario.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Catálogo de Herramientas -->
  <section id="catalogo" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Directorio de Micro-Herramientas
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
          Soluciones de un solo clic optimizadas para flujo de trabajo diario.
        </p>
      </div>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {availableTools.map((tool) => (
        <div class={`relative group rounded-2xl border transition-all duration-200 p-6 flex flex-col justify-between ${
          tool.isAvailable
            ? 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 hover:border-brand-500/50 hover:shadow-lg hover:shadow-brand-500/5'
            : 'bg-slate-50/50 dark:bg-slate-900/30 border-dashed border-slate-200 dark:border-slate-800/80 opacity-75'
        }`}>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                {tool.category}
              </span>
              <span class={`text-[11px] font-bold px-2 py-0.5 rounded-full ${
                tool.isAvailable
                  ? 'bg-brand-100 text-brand-700 dark:bg-brand-950 dark:text-brand-300'
                  : 'bg-slate-200 text-slate-600 dark:bg-slate-800 dark:text-slate-400'
              }`}>
                {tool.badge}
              </span>
            </div>

            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
              {tool.title}
            </h3>

            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
              {tool.description}
            </p>
          </div>

          <div>
            {tool.isAvailable ? (
              <a
                href={`/tools/${tool.slug}/`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300"
              >
                Abrir herramienta
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            ) : (
              <span class="text-xs font-medium text-slate-400 dark:text-slate-600 italic">
                En fase de desarrollo
              </span>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
