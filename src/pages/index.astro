---
// src/pages/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';

const toolCatalog = [
  {
    id: '01',
    title: 'Generador de QR by Silantro Labs',
    slug: 'qr-generator',
    domain: 'Codificación Óptica',
    inputOutput: 'Texto, URLs o VCard -> SVG / PNG',
    engine: 'Reed-Solomon (Client Canvas/SVG)',
    status: 'Disponible',
    isReady: true,
    description: 'Generación vectorial y rasterizada de códigos QR en alta resolución. Admite inserción de logo central de Silantro Labs o marcas personalizadas con compensación de error H (30%).',
  },
  {
    id: '02',
    title: 'Formateador e Inspector JSON',
    slug: 'json-formatter',
    domain: 'Manipulación de Datos',
    inputOutput: 'JSON plano -> Árbol interactivo ordenado',
    engine: 'V8 JSON Parser Nativo',
    status: 'En desarrollo',
    isReady: false,
    description: 'Validación de sintaxis, saneamiento de claves y formateo legible de estructuras complejas sin filtrar tokens ni credenciales.',
  },
  {
    id: '03',
    title: 'Conversor y Extractor Base64',
    slug: 'base64-converter',
    domain: 'Transformación Binaria',
    inputOutput: 'Archivos / Texto <-> Base64 URI',
    engine: 'FileReader & TypedArray API',
    status: 'En desarrollo',
    isReady: false,
    description: 'Codificación y decodificación de datos y archivos binarios directamente en el hilo de trabajo del navegador.',
  },
  {
    id: '04',
    title: 'Generador Criptográfico de Claves',
    slug: 'password-generator',
    domain: 'Criptografía',
    inputOutput: 'Parámetros de entropía -> String seguro',
    engine: 'Web Crypto API (crypto.getRandomValues)',
    status: 'En desarrollo',
    isReady: false,
    description: 'Generador de contraseñas y claves de paso aleatorias mediante entropía nativa del sistema operativo del usuario.',
  },
  {
    id: '05',
    title: 'Analizador Semántico de Texto',
    slug: 'word-counter',
    domain: 'Procesamiento de Lenguaje',
    inputOutput: 'Texto -> Métricas y densidad de lectura',
    engine: 'Intl.Segmenter & RegExp Engine',
    status: 'En desarrollo',
    isReady: false,
    description: 'Cálculo instantáneo de caracteres, palabras, tiempos de lectura y recurrencia léxica con cero llamadas de red.',
  },
];
---

<BaseLayout
  title="Silantro Tools — Suite de Micro-Herramientas Locales"
  description="Catálogo de herramientas de utilidad y transformación estática ejecutadas al 100% en el navegador por Silantro Labs. Privacidad absoluta, sin cómputo de servidor."
  canonicalPath="/"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <!-- Encabezado Editorial Técnico (Sin clichés ni heroes genéricos) -->
    <section class="border-b border-neutral-200 dark:border-neutral-800 pb-12 mb-12">
      <div class="flex items-center gap-2 font-mono text-xs text-neutral-500 uppercase tracking-wider mb-6">
        <span>Silantro Labs</span>
        <span>/</span>
        <span>Utility Infrastructure</span>
        <span>/</span>
        <span class="text-neutral-900 dark:text-neutral-100 font-semibold">Local Computing</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-neutral-950 dark:text-white max-w-4xl leading-[1.15]">
        Micro-herramientas de cómputo local y ejecución estática.
      </h1>

      <p class="mt-6 text-base sm:text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
        Cada herramienta de este catálogo opera íntegramente en la memoria de tu navegador mediante JavaScript y Web APIs nativas. Tus datos no se transmiten, no se almacenan en servidores y no dejan registros remotos.
      </p>

      <!-- Fila de Parámetros de Arquitectura -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-10 pt-8 border-t border-neutral-200 dark:border-neutral-800 font-mono text-xs">
        <div>
          <span class="text-neutral-400 block mb-1">01 / EJECUCIÓN</span>
          <span class="font-semibold text-neutral-900 dark:text-neutral-100">100% Client-Side</span>
        </div>
        <div>
          <span class="text-neutral-400 block mb-1">02 / EGRESO DE RED</span>
          <span class="font-semibold text-neutral-900 dark:text-neutral-100">0 bytes (Zero Egress)</span>
        </div>
        <div>
          <span class="text-neutral-400 block mb-1">03 / LATENCIA</span>
          <span class="font-semibold text-neutral-900 dark:text-neutral-100">&lt; 5ms en memoria</span>
        </div>
        <div>
          <span class="text-neutral-400 block mb-1">04 / DISPONIBILIDAD</span>
          <span class="font-semibold text-neutral-900 dark:text-neutral-100">Libre y sin registro</span>
        </div>
      </div>
    </section>

    <!-- Catálogo de Herramientas Estructurado -->
    <section aria-labelledby="catalogo-heading">
      <div class="flex items-baseline justify-between mb-6 pb-2 border-b border-neutral-200 dark:border-neutral-800">
        <h2 id="catalogo-heading" class="font-mono text-xs uppercase tracking-wider text-neutral-500">
          Directorio de Utilidades
        </h2>
        <span class="font-mono text-xs text-neutral-400">
          Total: {toolCatalog.length} módulos
        </span>
      </div>

      <!-- Lista Técnica de Módulos -->
      <div class="divide-y divide-neutral-200 dark:divide-neutral-800 border-b border-neutral-200 dark:border-neutral-800">
        {toolCatalog.map((tool) => (
          <article class={`py-6 transition-colors ${tool.isReady ? 'hover:bg-neutral-50/60 dark:hover:bg-neutral-900/30' : 'opacity-70'}`}>
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-start">
              <!-- Índice y Dominio -->
              <div class="md:col-span-2 font-mono text-xs flex md:flex-col justify-between md:justify-start gap-1 text-neutral-500">
                <span class="font-semibold text-neutral-900 dark:text-neutral-100">{tool.id}</span>
                <span class="text-neutral-400">{tool.domain}</span>
              </div>

              <!-- Título y Descripción -->
              <div class="md:col-span-6 space-y-1.5">
                <h3 class="text-base font-semibold text-neutral-950 dark:text-white">
                  {tool.isReady ? (
                    <a href={`/tools/${tool.slug}/`} class="hover:underline underline-offset-4 decoration-neutral-400">
                      {tool.title}
                    </a>
                  ) : (
                    <span>{tool.title}</span>
                  )}
                </h3>
                <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-xl">
                  {tool.description}
                </p>
                <div class="font-mono text-[11px] text-neutral-500 pt-1">
                  <span class="text-neutral-400">E/S:</span> {tool.inputOutput}
                </div>
              </div>

              <!-- Motor / Algoritmo -->
              <div class="md:col-span-2 hidden md:block font-mono text-[11px] text-neutral-500">
                <span class="text-neutral-400 block text-[10px] uppercase">Motor</span>
                <span>{tool.engine}</span>
              </div>

              <!-- Acción y Estado -->
              <div class="md:col-span-2 flex md:justify-end items-center">
                {tool.isReady ? (
                  <a
                    href={`/tools/${tool.slug}/`}
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded border border-neutral-900 dark:border-neutral-100 bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-950 text-xs font-semibold hover:opacity-90 transition-opacity"
                  >
                    <span>Ejecutar</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </a>
                ) : (
                  <span class="font-mono text-[11px] text-neutral-400 border border-neutral-200 dark:border-neutral-800 px-2.5 py-1 rounded">
                    En desarrollo
                  </span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Manifiesto Técnico de Privacidad Arquitectónica -->
    <section class="mt-16 pt-10 border-t border-neutral-200 dark:border-neutral-800">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <h3 class="font-semibold text-sm text-neutral-900 dark:text-white mb-2">
            Aislamiento de Cómputo
          </h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Ninguna herramienta envía peticiones POST o PUT con los datos ingresados. Los hilos de renderizado y análisis residen en los Web Workers o en el contexto 2D del Canvas local.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-sm text-neutral-900 dark:text-white mb-2">
            Arquitectura de Islas Estáticas
          </h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            El framework base compila únicamente a HTML y CSS puros. Cada herramienta descarga sus librerías específicas de manera aislada (*lazy loading*) solo cuando el usuario accede a ella.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-sm text-neutral-900 dark:text-white mb-2">
            Infraestructura Distribuida
          </h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Servido globalmente mediante la red Anycast de Cloudflare Pages con caché inmutable y cifrado SSL/TLS de grado estricto.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
