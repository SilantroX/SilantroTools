---
// src/pages/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolCatalog from '@/components/catalog/ToolCatalog';
import AdSlot from '@/components/ads/AdSlot.astro';
---

<BaseLayout
  title="Silantro Tools — Herramientas Rápidas de Cómputo Local"
  description="Catálogo de micro-herramientas web de cómputo en navegador. Privacidad garantizada, procesamiento 100% en el cliente y sin dependencias de servidor."
  canonicalPath="/"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 md:py-10">
    <!-- Encabezado Editorial Conciso y Directo -->
    <section class="border-b border-neutral-200 dark:border-neutral-800 pb-6 mb-6 sm:pb-8 sm:mb-8">
      <div class="inline-flex items-center gap-2 font-mono text-[11px] text-neutral-500 uppercase tracking-wider mb-2.5">
        <span>Silantro Labs</span>
        <span class="text-neutral-300 dark:text-neutral-700" aria-hidden="true">/</span>
        <span class="text-neutral-900 dark:text-neutral-100 font-semibold">Local Computing Suite</span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-neutral-950 dark:text-white max-w-3xl leading-[1.15]">
        Herramientas esenciales de cómputo local.
      </h1>

      <p class="mt-2.5 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
        Utilidades web rápidas para tareas de codificación, formateo y transformación. Cada operación se ejecuta directamente en la memoria volátil de tu navegador, sin enviar datos a servidores externos ni almacenar registros.
      </p>

      <!-- Fila de Garantías de Arquitectura -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-5 pt-4 border-t border-neutral-200 dark:border-neutral-800">
        <div class="flex items-start gap-2.5">
          <div class="w-6 h-6 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center flex-shrink-0 text-neutral-800 dark:text-neutral-200 text-[11px] font-mono font-bold" aria-hidden="true">
            01
          </div>
          <div>
            <span class="text-xs font-semibold text-neutral-900 dark:text-neutral-100 block">100% Client-Side</span>
            <span class="text-[11px] text-neutral-500 leading-normal block">Procesado con Web APIs nativas en tu CPU/GPU local.</span>
          </div>
        </div>

        <div class="flex items-start gap-2.5">
          <div class="w-6 h-6 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center flex-shrink-0 text-neutral-800 dark:text-neutral-200 text-[11px] font-mono font-bold" aria-hidden="true">
            02
          </div>
          <div>
            <span class="text-xs font-semibold text-neutral-900 dark:text-neutral-100 block">Cero Egreso de Datos</span>
            <span class="text-[11px] text-neutral-500 leading-normal block">Tus textos, contraseñas o archivos nunca salen del dispositivo.</span>
          </div>
        </div>

        <div class="flex items-start gap-2.5">
          <div class="w-6 h-6 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center flex-shrink-0 text-neutral-800 dark:text-neutral-200 text-[11px] font-mono font-bold" aria-hidden="true">
            03
          </div>
          <div>
            <span class="text-xs font-semibold text-neutral-900 dark:text-neutral-100 block">Sin Registro ni Esperas</span>
            <span class="text-[11px] text-neutral-500 leading-normal block">Acceso libre inmediato, sin límites arbitrarios ni cookies invasivas.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Catálogo de Herramientas Interactivo -->
    <ToolCatalog client:load />

    <!-- Sección de Arquitectura y Principios de Privacidad -->
    <section class="mt-10 pt-8 sm:mt-12 sm:pt-8 border-t border-neutral-200 dark:border-neutral-800" aria-label="Arquitectura Técnica">
      <div class="mb-4">
        <span class="font-mono text-[11px] uppercase tracking-wider text-neutral-500">Arquitectura Técnica</span>
        <h2 class="text-base sm:text-lg font-bold text-neutral-950 dark:text-white mt-0.5">
          ¿Por qué ejecutar herramientas en el navegador?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-4 sm:p-5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 space-y-1.5">
          <h3 class="font-semibold text-xs uppercase tracking-wider text-neutral-900 dark:text-white font-mono">
            Aislamiento Criptográfico
          </h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Al no enviar solicitudes HTTP hacia ningún backend para procesar datos, eliminamos el vector de ataque más común: la interceptación de credenciales, tokens o enlaces sensibles en tránsito o en logs de acceso.
          </p>
        </div>

        <div class="p-4 sm:p-5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 space-y-1.5">
          <h3 class="font-semibold text-xs uppercase tracking-wider text-neutral-900 dark:text-white font-mono">
            Latencia Sub-milisegundo
          </h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Sin la sobrecarga de un viaje de ida y vuelta al servidor (round-trip time), las operaciones de renderizado, cálculo y formateo responden a la velocidad de tu propio procesador.
          </p>
        </div>

        <div class="p-4 sm:p-5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 space-y-1.5">
          <h3 class="font-semibold text-xs uppercase tracking-wider text-neutral-900 dark:text-white font-mono">
            Disponibilidad Sin Conexión
          </h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Una vez cargados los recursos estáticos iniciales, el motor de ejecución es autosuficiente y puede seguir funcionando incluso ante caídas de conectividad.
          </p>
        </div>
      </div>
    </section>

    <!-- Espacio publicitario manual al final del catálogo -->
    <AdSlot
      slotId={import.meta.env.PUBLIC_ADSENSE_SLOT_HOME_BOTTOM || "ad-home-bottom"}
      slotName="Catálogo Principal (Inferior)"
      format="horizontal-responsive"
      className="mt-10"
    />
  </div>
</BaseLayout>
