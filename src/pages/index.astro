---
// src/pages/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolCatalog from '@/components/catalog/ToolCatalog';
import AdSlot from '@/components/ads/AdSlot.astro';
import { ADS_CONFIG } from '@/lib/ads-config';
---

<BaseLayout
  title="Silantro Tools — Herramientas digitales útiles, gratuitas y privadas"
  description="Comprime fotos, crea códigos QR, limpia textos y genera contraseñas seguras directamente en tu navegador. 100% gratis, sin registro y sin subir tus archivos a internet."
  canonicalPath="/"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 md:py-12">
    <!-- Hero Principal -->
    <section class="border-b border-neutral-200 dark:border-neutral-800 pb-8 mb-8 sm:pb-10 sm:mb-10">
      <!-- Tag superior -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-100/70 dark:bg-neutral-900/80 text-[11px] font-mono font-medium text-neutral-700 dark:text-neutral-300 mb-4 select-none">
        <span class="w-1.5 h-1.5 rounded-full bg-neutral-900 dark:bg-white animate-pulse" aria-hidden="true"></span>
        <span>Silantro Tools • Gratis, fácil y sin registros</span>
      </div>

      <!-- Título Principal Atractivo y Claro -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-neutral-950 dark:text-white max-w-3xl leading-[1.12]">
        Herramientas sencillas para tus tareas cotidianas.
      </h1>

      <!-- Subtítulo Enfocado en Beneficios -->
      <p class="mt-3.5 sm:mt-4 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
        Comprime fotos para trámites, crea códigos QR para tus proyectos, limpia textos y genera contraseñas seguras. Todo funciona directamente en tu navegador: gratis, al instante y sin que tus archivos salgan de tu dispositivo.
      </p>

      <!-- Llamados a la Acción (CTAs) -->
      <div class="mt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 sm:gap-3">
        <a
          href="#catalogo"
          class="btn-primary py-2.5 px-5 text-xs sm:text-sm font-semibold rounded-lg shadow-2xs hover:opacity-95 transition-all flex items-center justify-center gap-2"
        >
          <span>Explorar herramientas</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
          </svg>
        </a>

        <div class="grid grid-cols-2 gap-2 sm:flex sm:items-center">
          <a
            href="/tools/qr-generator/"
            class="btn-secondary py-2.5 px-3.5 text-xs sm:text-sm font-medium rounded-lg transition-colors text-center"
          >
            Generador QR
          </a>

          <a
            href="/tools/image-compressor/"
            class="btn-secondary py-2.5 px-3.5 text-xs sm:text-sm font-medium rounded-lg transition-colors text-center"
          >
            Compresor
          </a>
        </div>
      </div>

      <!-- Fila de Garantías Claras para el Usuario -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8 pt-6 border-t border-neutral-200 dark:border-neutral-800">
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center flex-shrink-0 text-neutral-900 dark:text-white" aria-hidden="true">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xs sm:text-sm font-semibold text-neutral-900 dark:text-neutral-100">Sin registro ni cuentas</h2>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 leading-relaxed">
              Úsalas al instante sin escribir correos, contraseñas ni suscripciones obligatorias.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center flex-shrink-0 text-neutral-900 dark:text-white" aria-hidden="true">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xs sm:text-sm font-semibold text-neutral-900 dark:text-neutral-100">Tus archivos se quedan contigo</h2>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 leading-relaxed">
              Se procesan dentro de tu propio navegador. No se transfieren a ningún servidor externo.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 flex items-center justify-center flex-shrink-0 text-neutral-900 dark:text-white" aria-hidden="true">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xs sm:text-sm font-semibold text-neutral-900 dark:text-neutral-100">Rápido y 100% gratuito</h2>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 leading-relaxed">
              Sin esperas en colas remotas, sin tarifas sorpresa y listo para usarse cuando lo necesites.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Catálogo de Herramientas Interactivo (Sección Protagonista) -->
    <ToolCatalog client:load />

    <!-- Sección de Privacidad y Confianza -->
    <section class="mt-14 sm:mt-18 pt-10 sm:pt-12 border-t border-neutral-200 dark:border-neutral-800" aria-labelledby="privacy-title">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold mb-1">
          <span class="w-1.5 h-1.5 rounded-full bg-neutral-900 dark:bg-neutral-100" aria-hidden="true"></span>
          Privacidad y Confianza
        </span>
        <h2 id="privacy-title" class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-neutral-950 dark:text-white">
          Tus archivos bajo tu control, sin intermediarios
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Muchas herramientas en internet te piden subir tus fotos o textos a sus servidores para procesarlos. En Silantro Tools lo hacemos diferente: todo el trabajo se realiza directamente en tu navegador web.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5 mt-7">
        <div class="p-5 sm:p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 space-y-2.5">
          <div class="w-9 h-9 rounded-lg bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700/60 flex items-center justify-center text-neutral-950 dark:text-white mb-2" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <h3 class="font-bold text-sm text-neutral-950 dark:text-white">
            Tus datos no salen de tu equipo
          </h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Las fotos que comprimes o los enlaces que conviertes en QR se procesan en la memoria de tu propio navegador. Ninguna copia viaja a servidores remotos.
          </p>
        </div>

        <div class="p-5 sm:p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 space-y-2.5">
          <div class="w-9 h-9 rounded-lg bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700/60 flex items-center justify-center text-neutral-950 dark:text-white mb-2" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
          </div>
          <h3 class="font-bold text-sm text-neutral-950 dark:text-white">
            Uso libre y anónimo
          </h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            No necesitas crear usuario ni compartir tu correo electrónico. Puedes usar cualquier herramienta disponible con total libertad y tranquilidad.
          </p>
        </div>

        <div class="p-5 sm:p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 space-y-2.5">
          <div class="w-9 h-9 rounded-lg bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700/60 flex items-center justify-center text-neutral-950 dark:text-white mb-2" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <h3 class="font-bold text-sm text-neutral-950 dark:text-white">
            Respuestas al segundo
          </h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Al no depender de transferencias pesadas hacia servidores lejanos, las herramientas responden inmediatamente, incluso si tu conexión a internet es lenta.
          </p>
        </div>
      </div>
    </section>

    <!-- Sección Institucional Sencilla: Cómo Funciona Silantro Tools -->
    <section class="mt-12 sm:mt-14 p-6 sm:p-8 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40" aria-label="Cómo funciona">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
        <div class="max-w-xl">
          <span class="font-mono text-[11px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold block mb-1">
            Uso Rápido
          </span>
          <h2 class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white">
            Tres pasos para resolver tu tarea
          </h2>
          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-1 leading-relaxed">
            Sin instalaciones, sin tutoriales complejos y sin configurar nada.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a href="#catalogo" class="btn-primary text-xs py-2 px-4 rounded-lg font-medium">
            Ver catálogo
          </a>
          <a href="/about/" class="btn-secondary text-xs py-2 px-4 rounded-lg font-medium">
            Acerca de Silantro
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-7 pt-6 border-t border-neutral-200/80 dark:border-neutral-800/80">
        <div class="space-y-1.5">
          <span class="text-xs font-mono font-bold text-neutral-400 dark:text-neutral-500">01</span>
          <h3 class="text-sm font-semibold text-neutral-950 dark:text-white">Elige la herramienta</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Selecciona la opción adecuada para tu necesidad en nuestro catálogo gratuito.
          </p>
        </div>

        <div class="space-y-1.5">
          <span class="text-xs font-mono font-bold text-neutral-400 dark:text-neutral-500">02</span>
          <h3 class="text-sm font-semibold text-neutral-950 dark:text-white">Añade tu contenido</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Escribe tu texto, arrastra tu fotografía o pega tu enlace para comenzar al instante.
          </p>
        </div>

        <div class="space-y-1.5">
          <span class="text-xs font-mono font-bold text-neutral-400 dark:text-neutral-500">03</span>
          <h3 class="text-sm font-semibold text-neutral-950 dark:text-white">Guarda el resultado</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Descarga tu archivo listo o copia el texto limpio, con máxima calidad y sin marcas de agua.
          </p>
        </div>
      </div>
    </section>

    <!-- Espacio publicitario manual al final del catálogo -->
    <AdSlot
      slotId={ADS_CONFIG.slots.homeBottom}
      slotName="Catálogo Principal (Inferior)"
      format="horizontal-responsive"
      className="mt-10"
    />
  </div>
</BaseLayout>
