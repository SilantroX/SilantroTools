---
// src/components/seo/SEOHead.astro
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  faqs?: Array<{ question: string; answer: string }>;
  isTool?: boolean;
}

const {
  title,
  description,
  canonicalPath = '',
  ogType = 'website',
  ogImage = '/logos/logo-con-fondo.jpg',
  faqs = [],
  isTool = false,
} = Astro.props;

const siteUrl = 'https://tools.silantrolabs.com';
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const fullOgImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).href;

// Schema WebApplication para herramientas
const webAppSchema = isTool ? {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  'name': title,
  'url': canonicalUrl,
  'description': description,
  'applicationCategory': 'UtilitiesApplication',
  'operatingSystem': 'All',
  'browserRequirements': 'Requires JavaScript. Requires HTML5.',
  'offers': {
    '@type': 'Offer',
    'price': '0',
    'priceCurrency': 'USD',
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Silantro Labs',
    'url': 'https://silantrolabs.com',
    'logo': new URL('/logos/logo-con-fondo.jpg', siteUrl).href,
  },
} : null;

// Schema FAQPage
const faqSchema = faqs && faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((faq) => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer,
    },
  })),
} : null;

// Schema Organización general
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Silantro Labs',
  'url': 'https://silantrolabs.com',
  'logo': new URL('/logos/logo-con-fondo.jpg', siteUrl).href,
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title} | Silantro Tools</title>
<meta name="title" content={`${title} | Silantro Tools`} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={`${title} | Silantro Tools`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImageUrl} />
<meta property="og:site_name" content="Silantro Tools" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={`${title} | Silantro Tools`} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={fullOgImageUrl} />

<!-- Theme Color (Monochrome) -->
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
{webAppSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
)}
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<!-- AdSense Script Placeholder (Listo para producción) -->
{import.meta.env.PROD && (
  <script
    async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX"
    crossorigin="anonymous"
  ></script>
)}
