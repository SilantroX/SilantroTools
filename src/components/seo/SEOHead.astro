---
// src/components/seo/SEOHead.astro
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  faqs?: Array<{ question: string; answer: string }>;
  isTool?: boolean;
  breadcrumbs?: Array<{ name: string; path: string }>;
}

const {
  title,
  description,
  canonicalPath = '',
  ogType = 'website',
  ogImage = '/logos/og-image.jpg',
  faqs = [],
  isTool = false,
  breadcrumbs = [],
} = Astro.props;

const siteUrl = 'https://tools.silantrolabs.com';

// Normalización estricta de canonical URL con trailingSlash: 'always'
let normalizedPath = canonicalPath || Astro.url.pathname || '/';
if (!normalizedPath.startsWith('/')) {
  normalizedPath = `/${normalizedPath}`;
}
if (!normalizedPath.endsWith('/') && !normalizedPath.includes('.')) {
  normalizedPath = `${normalizedPath}/`;
}
const canonicalUrl = new URL(normalizedPath, siteUrl).href;

// Imagen OpenGraph absoluta optimizada
const fullOgImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).href;

// Evitar duplicación de sufijo de marca en <title>
const cleanTitle = title.trim();
const formattedTitle = cleanTitle.includes('Silantro Tools') || cleanTitle.includes('Silantro Labs')
  ? cleanTitle
  : `${cleanTitle} | Silantro Tools`;

// Schema Organización
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Silantro Labs',
  'url': 'https://silantrolabs.com',
  'logo': new URL('/logos/logo-con-fondo-opt.webp', siteUrl).href,
  'sameAs': [
    'https://github.com/silantrolabs',
  ],
};

// Schema WebSite para la raíz
const isHome = normalizedPath === '/';
const webSiteSchema = isHome ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'Silantro Tools',
  'url': siteUrl,
  'description': description,
  'inLanguage': 'es',
  'publisher': {
    '@type': 'Organization',
    'name': 'Silantro Labs',
    'url': 'https://silantrolabs.com',
  },
} : null;

// Schema WebApplication para herramientas interactivas
const webAppSchema = isTool ? {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  'name': cleanTitle,
  'url': canonicalUrl,
  'description': description,
  'applicationCategory': 'UtilitiesApplication',
  'operatingSystem': 'All',
  'browserRequirements': 'Requires JavaScript. Requires HTML5 Canvas or SVG.',
  'inLanguage': 'es',
  'offers': {
    '@type': 'Offer',
    'price': '0',
    'priceCurrency': 'USD',
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Silantro Labs',
    'url': 'https://silantrolabs.com',
    'logo': new URL('/logos/logo-con-fondo-opt.webp', siteUrl).href,
  },
} : null;

// Schema FAQPage
const faqSchema = faqs && faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((faq) => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer,
    },
  })),
} : null;

// Schema Breadcrumbs
const breadcrumbItems = [
  { name: 'Inicio', path: '/' },
  ...breadcrumbs,
];
const breadcrumbSchema = breadcrumbItems.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'name': item.name,
    'item': new URL(item.path.endsWith('/') ? item.path : `${item.path}/`, siteUrl).href,
  })),
} : null;

// Control seguro de AdSense: Solo se inyecta con ID real de producción
const adsenseId = import.meta.env.PUBLIC_ADSENSE_ID || 'ca-pub-1982658636778600';
const hasValidAdsense = Boolean(adsenseId && !adsenseId.includes('XXXX'));
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="format-detection" content="telephone=no" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Silantro Tools — Suite de Cómputo Local" />
<meta property="og:site_name" content="Silantro Tools" />
<meta property="og:locale" content="es_ES" />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImageUrl} />
<meta name="twitter:image:alt" content="Silantro Tools" />

<!-- Theme Color dinámico con fallback -->
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
{webSiteSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
)}
{webAppSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
)}
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}

<!-- AdSense Script (Listo para producción cuando se configure PUBLIC_ADSENSE_ID) -->
{hasValidAdsense && (
  <script
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`}
    crossorigin="anonymous"
  ></script>
)}
