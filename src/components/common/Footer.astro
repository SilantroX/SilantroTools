---
// src/components/common/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-950 text-neutral-600 dark:text-neutral-400 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 text-xs">
      <!-- Columna 1: Brand & Filosofía -->
      <div class="md:col-span-6 space-y-3">
        <div class="flex items-center gap-2 text-neutral-950 dark:text-white font-semibold text-sm">
          <img
            src="/logos/logo-con-fondo.jpg"
            alt="Silantro Labs"
            class="w-5 h-5 rounded object-cover border border-neutral-300 dark:border-neutral-700"
          />
          <span>Silantro Tools</span>
        </div>
        <p class="max-w-md text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Conjunto de micro-herramientas de cómputo estático en navegador desarrolladas por Silantro Labs. La lógica de codificación, formateo y renderizado se ejecuta localmente en la memoria del cliente, sin envío de datos a servidores externos.
        </p>
        <p class="font-mono text-[11px] text-neutral-500">
          Procesamiento: 100% Client-side • Cero persistencia • Sin rastreo de contenido
        </p>
      </div>

      <!-- Columna 2: Herramientas -->
      <div class="md:col-span-3 space-y-2">
        <p class="font-semibold text-neutral-900 dark:text-neutral-200 uppercase tracking-wider text-[11px]">
          Herramientas
        </p>
        <ul class="space-y-1.5">
          <li>
            <a href="/tools/qr-generator/" class="hover:text-neutral-950 dark:hover:text-white transition-colors">
              Generador de QR by Silantro Labs
            </a>
          </li>
          <li class="text-neutral-400 dark:text-neutral-600 font-mono text-[11px]">
            [ Formateador JSON - Próximamente ]
          </li>
          <li class="text-neutral-400 dark:text-neutral-600 font-mono text-[11px]">
            [ Conversor Base64 - Próximamente ]
          </li>
          <li class="text-neutral-400 dark:text-neutral-600 font-mono text-[11px]">
            [ Analizador de Texto - Próximamente ]
          </li>
        </ul>
      </div>

      <!-- Columna 3: Legal & Institucional -->
      <div class="md:col-span-3 space-y-2">
        <p class="font-semibold text-neutral-900 dark:text-neutral-200 uppercase tracking-wider text-[11px]">
          Institucional
        </p>
        <ul class="space-y-1.5">
          <li>
            <a href="/about/" class="hover:text-neutral-950 dark:hover:text-white transition-colors">
              Acerca de Silantro Labs
            </a>
          </li>
          <li>
            <a href="/privacy/" class="hover:text-neutral-950 dark:hover:text-white transition-colors">
              Política de Privacidad
            </a>
          </li>
          <li>
            <a href="/terms/" class="hover:text-neutral-950 dark:hover:text-white transition-colors">
              Términos de Servicio
            </a>
          </li>
          <li>
            <a href="/cookies/" class="hover:text-neutral-950 dark:hover:text-white transition-colors">
              Política de Cookies
            </a>
          </li>
          <li>
            <a href="/contact/" class="hover:text-neutral-950 dark:hover:text-white transition-colors">
              Contacto y Soporte
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-neutral-200 dark:border-neutral-800 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between text-[11px] text-neutral-500 gap-3">
      <span>
        &copy; {currentYear} Silantro Labs. Todos los derechos reservados.
      </span>
      <span class="font-mono">
        tools.silantrolabs.com
      </span>
    </div>
  </div>
</footer>
