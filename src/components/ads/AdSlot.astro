---
// src/components/ads/AdSlot.astro
import { ADS_CONFIG } from '@/lib/ads-config';

interface Props {
  slotId?: string;
  slotName?: string;
  format?: 'rectangle' | 'leaderboard' | 'horizontal-responsive';
  className?: string;
}

const {
  slotId = '',
  slotName = '',
  format = 'horizontal-responsive',
  className = '',
} = Astro.props;

const adsenseId = ADS_CONFIG.clientId;
const cleanSlotId = slotId?.trim();
const isNumericSlot = Boolean(cleanSlotId && /^\d{8,16}$/.test(cleanSlotId));
const adFormat = format === 'rectangle' ? 'rectangle' : 'auto';
---

<aside
  class={`ad-slot-container my-4 flex flex-col items-center justify-center mx-auto w-full transition-all overflow-hidden ${className}`}
  data-ad-slot-name={slotName || cleanSlotId || 'AdSense'}
  aria-label="Espacio de publicidad"
>
  <ins
    class="adsbygoogle block w-full"
    style="display:block"
    data-ad-client={adsenseId}
    {...(isNumericSlot ? { 'data-ad-slot': cleanSlotId } : {})}
    data-ad-format={adFormat}
    data-full-width-responsive="true"
  ></ins>
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</aside>
