---
// src/components/ads/AdSlot.astro
interface Props {
  slotId?: string;
  format?: 'rectangle' | 'leaderboard' | 'horizontal-responsive';
  className?: string;
}

const { slotId = 'default-slot', format = 'rectangle', className = '' } = Astro.props;

// Dimensiones fijas mínimas para garantizar CLS = 0
const formatClasses = {
  rectangle: 'min-h-[250px] min-w-[300px] max-w-[336px]',
  leaderboard: 'min-h-[90px] w-full max-w-[728px]',
  'horizontal-responsive': 'min-h-[100px] w-full max-w-4xl',
}[format];
---

<aside
  class={`ad-slot-reserved my-8 flex flex-col items-center justify-center mx-auto ${className}`}
  aria-label="Espacio de publicidad"
>
  <span class="font-mono text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-600 mb-1.5">
    Publicidad
  </span>
  <div
    class={`relative flex items-center justify-center border border-dashed border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/30 text-center overflow-hidden transition-all ${formatClasses}`}
  >
    {import.meta.env.PROD && slotId !== 'default-slot' ? (
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
    ) : (
      <div class="p-4 font-mono text-[11px] text-neutral-400 dark:text-neutral-600 flex flex-col items-center gap-1 select-none">
        <span>[ Espacio Publicitario Reservado ]</span>
        <span class="text-[10px]">Zero Layout Shift Compliance</span>
      </div>
    )}
  </div>
</aside>
